# JoePDF — example environment configuration
# Copy this file to .env.local and adjust as needed.
# .env.local is gitignored — never commit it.

# ── Admin credentials ─────────────────────────────────────────────────────────
# SHA-256 hash of your admin password (with the internal salt).
# To generate: sign in to the app → Settings gear → Change credentials →
# fill in your password → click "Save credentials" → copy the hash shown.
#
# For local dev, paste it here:
# VITE_ADMIN_HASH=<paste hash here>
#
# For production (GitHub Pages / CI): add it as a GitHub Actions Secret named
# VITE_ADMIN_HASH in your repo Settings → Secrets and variables → Actions.
# The deploy.yml workflow injects it at build time.
#
# Without this variable the app falls back to credentials stored in localStorage
# on the current device (set via Settings → Change credentials).

# Optional: override the Vite dev server port
# VITE_PORT=5173
